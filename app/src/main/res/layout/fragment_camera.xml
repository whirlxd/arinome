<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.whirlxd.arinome.utils.AutoFitSurfaceView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- black transition mask for lens switches -->
    <View
        android:id="@+id/aperture_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="invisible" />

    <!-- tap-to-focus reticle (invisible but measured; positioned at tap point) -->
    <View
        android:id="@+id/focus_reticle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:visibility="invisible" />

    <!-- top bar: wordmark pill left, theme + format pinned right -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp">

        <TextView
            android:id="@+id/wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:text="arinome"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/theme_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="MOCHA"
            android:textColor="@color/subtext0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fmt_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="RAW+"
            android:textColor="@color/yellow"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- slide-up control panel -->
    <ScrollView
        android:id="@+id/controls_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="148dp"
        android:background="@drawable/bg_panel"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/controls_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/iso_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/shutter_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/wb_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/wb_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pro_label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="PRO MODE"
                    android:textColor="@color/subtext0"
                    android:textSize="11sp" />

                <Switch
                    android:id="@+id/pro_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/yellow"
                    android:trackTint="@color/surface0" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/iso_slider_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:text="ISO"
                    android:textColor="@color/subtext0"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/iso_slider"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:max="1000"
                    android:progress="290"
                    android:thumbTint="@color/yellow"
                    android:progressTint="@color/yellow"
                    android:progressBackgroundTint="@color/surface0" />

                <TextView
                    android:id="@+id/iso_slider_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:gravity="end"
                    android:text="100"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/exp_slider_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:text="SHUTTER"
                    android:textColor="@color/subtext0"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/exp_slider"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:max="1000"
                    android:progress="500"
                    android:thumbTint="@color/yellow"
                    android:progressTint="@color/yellow"
                    android:progressBackgroundTint="@color/surface0" />

                <TextView
                    android:id="@+id/exp_slider_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:gravity="end"
                    android:text="1/125"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/focus_slider_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:text="FOCUS"
                    android:textColor="@color/subtext0"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/focus_slider"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:max="1000"
                    android:progress="0"
                    android:thumbTint="@color/yellow"
                    android:progressTint="@color/yellow"
                    android:progressBackgroundTint="@color/surface0" />

                <TextView
                    android:id="@+id/focus_slider_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:gravity="end"
                    android:text="AF"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- lens selector row -->
    <LinearLayout
        android:id="@+id/lens_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="112dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <!-- bottom control bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingBottom="22dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/iso_chip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:text="ISO A"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowRadius="4" />

        <ImageButton
            android:id="@+id/capture_button"
            android:layout_width="124dp"
            android:layout_height="62dp"
            android:scaleType="center"
            android:background="@drawable/bg_shutter_pill"
            android:contentDescription="@string/capture" />

        <TextView
            android:id="@+id/zoom_chip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:singleLine="true"
            android:text="1.0X"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowRadius="4" />

    </LinearLayout>

</FrameLayout>
